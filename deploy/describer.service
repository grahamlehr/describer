[Unit]
Description=Describer departure board backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=describer
WorkingDirectory=/opt/describer
# The only credentials file: a system install has no checkout .env to shadow
# it, which removes a whole class of the "blanked key" trap (Addendum 1) --
# there is nothing left to read first.
EnvironmentFile=/etc/describer/describer.env
ExecStart=/opt/describer/.venv/bin/uvicorn describer.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
# Logs go to the journal: journalctl -u describer -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

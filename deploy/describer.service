[Unit]
Description=Describer departure board backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/describer
# Credentials for both data sources. The second is a dev convenience and is
# optional: a leading - means "carry on if it is not there".
EnvironmentFile=/etc/describer/describer.env
EnvironmentFile=-%h/describer/.env
ExecStart=%h/describer/.venv/bin/uvicorn describer.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
# Logs go to the journal: journalctl --user -u describer -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

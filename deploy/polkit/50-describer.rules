// What the describer system user may ask systemd and logind to do, and nothing
// else. Raspberry Pi OS Trixie ships polkitd 126 (Depends: libduktape207), well
// past the 0.106 that introduced JS rules, so this loads as-is. (Bookworm's 122
// used the same engine.)
//
// Four grants, each as narrow as polkit lets it be:
//
//   1. restart describer.service    the updater, when no deploy/ files changed
//   2. start describer-apply-deploy.service
//                                   the updater, when they did. The unit runs
//                                   as root but takes no input from us: see
//                                   deploy/apply-deploy.sh for what it trusts.
//   3. power off                    the Shut down button in /admin
//   4. reboot                       the Restart button in /admin
//
// Not granted: another unit, another verb (stop, enable, edit), or root.
polkit.addRule(function (action, subject) {
    if (subject.user != "describer") {
        return;
    }

    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit == "describer.service" && verb == "restart") {
            return polkit.Result.YES;
        }
        if (unit == "describer-apply-deploy.service" && verb == "start") {
            return polkit.Result.YES;
        }
    }

    // The -multiple-sessions variants apply when someone else is logged in
    // (a console login, an SSH session), which is exactly when a Pi kept for
    // years is likely to be asked to shut down.
    if (
        action.id == "org.freedesktop.login1.power-off" ||
        action.id == "org.freedesktop.login1.power-off-multiple-sessions" ||
        action.id == "org.freedesktop.login1.reboot" ||
        action.id == "org.freedesktop.login1.reboot-multiple-sessions"
    ) {
        return polkit.Result.YES;
    }
});

// Lets the describer system user restart its own backend service without a
// password, so an update from /admin can bring the new code up. Raspberry Pi
// OS Bookworm ships polkit 122 (libduktape207), well past the 0.106 that
// introduced JS rules, so this loads as-is.
//
// Nothing else is granted: not another unit, not another verb, not root.
polkit.addRule(function (action, subject) {
    if (
        action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "describer.service" &&
        action.lookup("verb") == "restart" &&
        subject.user == "describer"
    ) {
        return polkit.Result.YES;
    }
});

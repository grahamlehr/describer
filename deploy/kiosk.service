[Unit]
Description=Describer kiosk (cage + Chromium)
# A system unit, not a user one: cage needs a logind seat with the DRM and
# input devices, and a lingering user session never gets one. Binding to tty1
# and evicting its getty gives cage the console the login prompt was using.
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Filled in by deploy/install.sh from the installing user.
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_LIBINPUT_NO_DEVICES=1
# cage draws a pointer in the middle of the screen with no mouse attached and
# has no flag to hide it. It ignores XCURSOR_THEME and XCURSOR_SIZE, loading
# whatever theme is named "default", so deploy/install.sh writes a blank one
# under that name and this path puts it ahead of the system's.
Environment=XCURSOR_PATH=/usr/local/share/describer-cursors:/usr/share/icons
Environment=XCURSOR_THEME=describer-blank
Environment=XCURSOR_SIZE=24
# Wait for the backend (a user service) to answer before painting anything.
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8080/api/state >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/cage -d -- /usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-features=TranslateUI \
  --check-for-update-interval=31536000 \
  --autoplay-policy=no-user-gesture-required \
  --ozone-platform=wayland \
  --app=http://localhost:8080/
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target

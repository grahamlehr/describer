# Rail Data Marketplace API key for the Live Departure Board (LDBWS) product.
# Never commit the real .env — it is in .gitignore.
RDM_API_KEY=

# Realtime Trains bearer token, used as the fallback source. Request one from
# https://api-portal.rtt.io. It may be a long-life access token or a refresh
# token that the client exchanges for short-life ones; either works here.
RTT_TOKEN=
